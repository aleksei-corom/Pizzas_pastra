# ─────────────────────────────────────────────
# FastBite POS — Variables de configuracion
# ─────────────────────────────────────────────
# Copia este archivo a .env y ajusta los valores.
# Estos valores son los defaults que usa config.py.
# ─────────────────────────────────────────────

# ─── Informacion del Negocio ───
APP_NAME=FastBite POS
BUSINESS_NAME=FastBite POS
BUSINESS_SLOGAN=Gestion de Restaurantes y Comidas Rapidas
BUSINESS_PHONE=+58 412-000-0000
BUSINESS_ADDRESS=Av. Principal, Local 1

# ─── Moneda e Impuestos ───
CURRENCY_SYMBOL=$
CURRENCY_CODE=USD
TAX_RATE=0.16

# ─── Impresora Termica ───
PRINTER_NAME=
PRINTER_AUTO_CUT=true
PRINTER_PAPER_WIDTH=48
PRINTER_CODEPAGE=cp850
PRINTER_PRINT_QR=true
PRINTER_SAVE_PDF=true

# ─── Base de Datos ───
# DB_PATH se calcula automaticamente (APPDATA en Windows, ~/.fastbitepos en Linux/Mac)
